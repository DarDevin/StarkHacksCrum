#include <WiFi.h>
#include <HTTPClient.h>

bool pushTelemetryToFastAPI(
    const char* serverUrl,
    float latitude,
    float longitude,
    float angleDelta,
    bool isSalting,
    bool isFirstPing
) {
    if (WiFi.status() != WL_CONNECTED) {
        Serial.println("WiFi not connected");
        return false;
    }

    HTTPClient http;
    if (!http.begin(serverUrl)) {
        Serial.println("Failed to start HTTP connection");
        return false;
    }

    http.addHeader("Content-Type", "application/json");

    String json = "{";
    json += "\"latitude\":" + String(latitude, 6) + ",";
    json += "\"longitude\":" + String(longitude, 6) + ",";
    json += "\"angle_delta\":" + String(angleDelta, 2) + ",";
    json += "\"is_salting\":" + String(isSalting ? "true" : "false") + ",";
    json += "\"is_first_ping\":" + String(isFirstPing ? "true" : "false");
    json += "}";

    int httpCode = http.POST(json);
    String response = http.getString();

    Serial.print("HTTP code: ");
    Serial.println(httpCode);
    Serial.print("Response: ");
    Serial.println(response);

    http.end();
    return (httpCode >= 200 && httpCode < 300);
}